# Builds the SPA and bakes it into the nginx image that also fronts the API.
FROM node:22-alpine AS build

WORKDIR /app

COPY Frontend/package*.json ./
RUN npm ci

COPY Frontend/ ./

# Vite inlines these at build time, so they must be the public URLs, not container names.
ARG VITE_API_URL
ARG VITE_AUTH_URL
ARG VITE_WS_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AUTH_URL=$VITE_AUTH_URL
ENV VITE_WS_URL=$VITE_WS_URL

RUN npm run build


FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

RUN rm /etc/nginx/conf.d/default.conf

EXPOSE 80 443
